	(text_box "BMP581\n\nSynopsis:\n\n	Barometric Pressure Sensor\n	\nDatasheet:\n\n	https://www.bosch-sensortec.com/media/boschsensortec/downloads/datasheets/bst-bmp581-ds004.pdf\n\nVoltage:\n\n	VDDIO: 1.2V to 3.3V\n	VDD: 1.8V to 3.3V\n\nModel:\n\n	https://www.snapeda.com/parts/BMP581/Bosch/view-part/?ref=search&t=BMP581&ab_test_case=b\n\nSDO:\n\n	The chip reads the voltage level of the SDO pin to establish its identifier on the I2C bus.\n\n\n	SDO tied to Ground (VSSIO): The I2C address becomes 0x46.\n	SDO tied to Power (VDDIO): The I2C address becomes 0x47"
		(exclude_from_sim no)
