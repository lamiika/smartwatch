	(text_box "MAX30101EFD\n\nSynopsis:\n\n	High-Sensitivity Pulse Oximeter and Heart-Rate Sensor for Wearable Health\n	\nDatasheet:\n\n	https://www.analog.com/media/en/technical-documentation/data-sheets/MAX30101.pdf\n\nVoltage:\n\n	VDD to GND: -0.2V to 2.2V\n	GND to PGND: -0.3V to +0.3V\n	VLED to PGND: -0.3V to +6.0V\n	I2C to GND: 1.8V\n	All other pins to GND: -0.3V to +6.0V\n\nI2C:\n\n	I2C_ADDR = 0x57"
